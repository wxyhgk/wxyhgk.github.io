---
interface Props {
	views?: Record<string, { format: string; view: number[]; display?: unknown }>;
	articleSlug: string;
}

const { views = {}, articleSlug } = Astro.props;
const serializedViews = JSON.stringify(views).replaceAll('<', '\\u003c');
---

<script id="chemistry-view-config" type="application/json" set:html={serializedViews}></script>
<script id="chemistry-resource-config" type="application/json" set:html={JSON.stringify({ articleSlug }).replaceAll('<', '\\u003c')}></script>

<script>
	import '../science/browser/molecule-renderer.css';
	import { setMoleculeViewContext } from '../science/browser/molecule-renderer.ts';
	import { setScienceResourceBaseUrl } from '../science/browser/resource-context.ts';
	import { renderScienceCodeBlocks } from '../science/browser/science-renderer.ts';

	const config = document.querySelector<HTMLScriptElement>('#chemistry-view-config');
	const resourceConfig = document.querySelector<HTMLScriptElement>('#chemistry-resource-config');
	const resource = resourceConfig?.textContent ? JSON.parse(resourceConfig.textContent) : {};
	setMoleculeViewContext({ views: config?.textContent ? JSON.parse(config.textContent) : {} });
	setScienceResourceBaseUrl(`/article-assets/${encodeURIComponent(resource.articleSlug ?? '')}`);
	renderScienceCodeBlocks();
	document.addEventListener('chemistry:render', ((event: CustomEvent<ParentNode>) => {
		renderScienceCodeBlocks(event.detail ?? document);
	}) as EventListener);
</script>
