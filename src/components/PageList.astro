---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { isPublishedArticle } from '../studio/server/schemas.mjs';

const posts = (await getCollection('blog'))
	.filter(isPublishedArticle)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<div class="page-rows">
	{
		posts.map((post) => (
			<a class="page-row" href={`/blog/${post.id}/`}>
				<span class="page-glyph" aria-hidden="true">{post.data.title.slice(0, 1)}</span>
				<span class="page-row-title">{post.data.title}</span>
				<span class="page-row-meta"><FormattedDate date={post.data.pubDate} /></span>
			</a>
		))
	}
</div>

<style>
	.page-glyph {
		display: grid;
		width: 20px;
		height: 20px;
		place-items: center;
		color: rgb(var(--gray));
		font-size: 14px;
		font-weight: 650;
	}
</style>
