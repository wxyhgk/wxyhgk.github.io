---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

const { headings } = Astro.props as { headings: Heading[] };
const visibleHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{
	visibleHeadings.length > 0 && (
		<nav class="outline-rail" data-toc aria-label="文章目录">
			<div class="outline-pop">
				<ol>
					{visibleHeadings.map((heading) => (
						<li class:list={{ child: heading.depth === 3 }}>
							<a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a>
						</li>
					))}
				</ol>
			</div>
			<div class="outline-marks" aria-hidden="true">
				{visibleHeadings.map((heading) => (
					<i class:list={{ child: heading.depth === 3 }} data-toc-mark={heading.slug} />
				))}
			</div>
		</nav>
	)
}

<script>
	const toc = document.querySelector<HTMLElement>('[data-toc]');
	if (toc) {
		const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
		const marks = [...toc.querySelectorAll<HTMLElement>('[data-toc-mark]')];
		const sections = links
			.map((link) => document.getElementById(link.dataset.tocLink ?? ''))
			.filter((section): section is HTMLElement => Boolean(section));
		const scroller = toc.closest<HTMLElement>('.workspace-scroll') ?? document.documentElement;

		const updateCurrent = () => {
			const limit = scroller.getBoundingClientRect().top + 88;
			let current: string | undefined;
			for (const section of sections) {
				if (section.getBoundingClientRect().top <= limit) current = section.id;
			}
			for (const link of links) {
				if (link.dataset.tocLink === current) link.setAttribute('aria-current', 'location');
				else link.removeAttribute('aria-current');
			}
			for (const mark of marks) {
				mark.toggleAttribute('data-current', mark.dataset.tocMark === current);
			}
		};

		for (const link of links) {
			link.addEventListener('click', (event) => {
				const section = document.getElementById(link.dataset.tocLink ?? '');
				if (!section) return;
				event.preventDefault();
				section.scrollIntoView({ block: 'start' });
				const hash = `#${link.dataset.tocLink}`;
				if (location.hash !== hash) history.replaceState(null, '', hash);
				updateCurrent();
			});
		}

		updateCurrent();
		scroller.addEventListener('scroll', updateCurrent, { passive: true });
		const hash = decodeURIComponent(location.hash.slice(1));
		if (hash) document.getElementById(hash)?.scrollIntoView({ block: 'start' });
	}
</script>

<style>
	.outline-rail {
		position: fixed;
		z-index: 12;
		top: 118px;
		right: 8px;
		display: flex;
		align-items: flex-start;
		pointer-events: none;
	}
	.outline-pop {
		width: 220px;
		max-height: min(68vh, 520px);
		margin-right: 2px;
		overflow: auto;
		opacity: 0;
		pointer-events: none;
	}
	.outline-rail:hover .outline-pop,
	.outline-rail:focus-within .outline-pop { opacity: 1; pointer-events: auto; }
	.outline-pop ol { display: grid; gap: 1px; margin: 0; padding: 4px; list-style: none; }
	.outline-pop a {
		display: block;
		padding: 3px 8px;
		border-radius: 4px;
		color: rgb(var(--gray));
		font-size: 13px;
		line-height: 1.35;
		text-align: right;
		text-decoration: none;
	}
	.outline-pop li.child a { font-size: 12px; }
	.outline-pop a:hover { background: var(--surface-hover); color: rgb(var(--black)); }
	.outline-pop a[aria-current='location'] { color: rgb(var(--black)); font-weight: 600; }
	.outline-marks {
		display: grid;
		justify-items: end;
		gap: 10px;
		width: 22px;
		padding: 8px 2px;
		pointer-events: auto;
	}
	.outline-marks i {
		display: block;
		width: 14px;
		height: 1px;
		border-radius: 1px;
		background: rgb(var(--gray));
		opacity: 0.55;
	}
	.outline-marks i.child { width: 8px; }
	.outline-marks i[data-current] { height: 2px; background: rgb(var(--gray-dark)); opacity: 1; }
	@media (max-width: 1080px) {
		.outline-rail { display: none; }
	}
</style>
