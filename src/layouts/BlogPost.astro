---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { loadCatalog, relatedArticles } from '../catalog';
import ChemistryRenderers from '../components/ChemistryRenderers.astro';
import CodeFiles from '../components/CodeFiles.astro';
import FormattedDate from '../components/FormattedDate.astro';
import RelatedEntries from '../components/RelatedEntries.astro';
import TableOfContents from '../components/TableOfContents.astro';
import WorkspaceFrame from '../components/WorkspaceFrame.astro';
import { SITE_TITLE } from '../consts';
import '../callouts/callouts.css';
import '../figures/figures.css';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: Heading[];
	chemistryViews?: Record<string, { format: string; view: number[]; display?: unknown }>;
	articleSlug: string;
};
const { title, description, pubDate, updatedDate, heroImage, icon, tags, kind, headings = [], chemistryViews = {}, articleSlug } = Astro.props;
const wiki = kind === 'wiki';
const { wiki: wikiPages, posts } = await loadCatalog();
const current = [...wikiPages, ...posts].find((entry) => entry.id === articleSlug);
const related = current ? relatedArticles([...wikiPages, ...posts], current) : [];
---

<WorkspaceFrame
	title={title}
	description={description}
	crumbs={[{ label: SITE_TITLE, href: '/' }, { label: wiki ? '维基' : '博客', href: wiki ? '/wiki' : '/blog' }, { label: title }]}
	editHref={`/studio?article=${articleSlug}`}
	icon={icon}
>
	{heroImage && (
		<div class="notion-cover" slot="cover">
			<Image width={1600} height={420} src={heroImage} alt="" />
		</div>
	)}
	<p class="page-meta" slot="properties">
		<a class="page-kind" href={wiki ? '/wiki' : '/blog'}>{wiki ? '维基' : '博客'}</a>
		<span class="page-meta-tags"><FormattedDate date={pubDate} /></span>
		{updatedDate && <> · 更新于 <FormattedDate date={updatedDate} /></>}
		{tags.length > 0 && <span class="page-meta-tags">{tags.join(' · ')}</span>}
	</p>
	<TableOfContents headings={headings} />
	<slot />
	<RelatedEntries entries={related} />
	<ChemistryRenderers views={chemistryViews} articleSlug={articleSlug} />
	<CodeFiles />
</WorkspaceFrame>
