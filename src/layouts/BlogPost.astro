---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ChemistryRenderers from '../components/ChemistryRenderers.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import WorkspaceFrame from '../components/WorkspaceFrame.astro';
import { SITE_TITLE } from '../consts';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: Heading[];
	chemistryViews?: Record<string, { format: string; view: number[]; display?: unknown }>;
	articleSlug: string;
};
const { title, description, pubDate, updatedDate, heroImage, tags, headings = [], chemistryViews = {}, articleSlug } = Astro.props;
---

<WorkspaceFrame
	title={title}
	description={description}
	crumbs={[{ label: SITE_TITLE, href: '/' }, { label: '文章', href: '/blog' }, { label: title }]}
	editHref={`/studio?article=${articleSlug}`}
>
	{heroImage && (
		<div class="notion-cover" slot="cover">
			<Image width={1600} height={420} src={heroImage} alt="" />
		</div>
	)}
	<p class="page-meta" slot="properties">
		<FormattedDate date={pubDate} />
		{updatedDate && <> · 更新于 <FormattedDate date={updatedDate} /></>}
		{tags.length > 0 && <span class="page-meta-tags">{tags.join(' · ')}</span>}
	</p>
	<TableOfContents headings={headings} />
	<slot />
	<ChemistryRenderers views={chemistryViews} articleSlug={articleSlug} />
</WorkspaceFrame>
