---
import BaseHead from '../../components/BaseHead.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`Crepe Lab · ${SITE_TITLE}`} description="Milkdown Crepe 兼容性实验室" /></head>
	<body class="lab-body">
		<header class="lab-bar">
			<div class="lab-brand">
				<a href="/">{SITE_TITLE}</a>
				<a class="studio-link" href="/studio/">Studio</a>
				<span>Crepe Lab</span>
			</div>
			<div class="lab-actions">
				<span id="roundtrip-status" class="roundtrip-status">等待载入</span>
				<span id="save-status" class="save-status">正在连接…</span>
				<a id="open-article" href="/blog" target="_blank">打开博客</a>
				<button id="save-button" type="button" disabled>保存</button>
			</div>
		</header>

		<main class="lab-shell">
			<aside class="article-sidebar">
				<div class="panel-heading">
					<div><strong>真实文章</strong><small>直接读取 article bundle</small></div>
				</div>
				<nav id="article-list" aria-label="文章列表"></nav>
				<section class="lab-notes">
					<h2>本轮检查</h2>
					<ul>
						<li>Markdown 载入往返</li>
						<li>公式与表格编辑</li>
						<li>科学 fenced code 保留</li>
						<li>中文输入与撤销</li>
					</ul>
					<p>⌘/Ctrl + Enter 保存</p>
				</section>
			</aside>

			<section class="editor-panel" aria-label="Crepe 编辑器实验">
				<div class="panel-label">
					<span id="editor-path">选择一篇文章</span>
					<span id="difference-detail">尚未比较</span>
				</div>
				<div id="crepe-editor" class="crepe-host"></div>
			</section>
		</main>

		<script>import '../../studio/crepe-lab';</script>
	</body>
</html>

<style>
	:global(body.lab-body) { height: 100vh; overflow: hidden; font-size: 16px; }
	.lab-bar { position: relative; z-index: 10; display: flex; align-items: center; justify-content: space-between; height: 52px; padding: 0 14px; border-bottom: 1px solid rgb(var(--gray-light)); background: var(--surface); }
	.lab-brand, .lab-actions { display: flex; align-items: center; gap: 10px; }
	.lab-brand a { color: rgb(var(--black)); font-weight: 700; text-decoration: none; }
	.lab-brand .studio-link { color: rgb(var(--gray)); font-size: 12px; font-weight: 500; }
	.lab-brand span { padding: 2px 7px; border-radius: 5px; background: #eef4ff; color: #315ea8; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; }
	.lab-actions a, .lab-actions button { padding: 6px 11px; border: 1px solid rgb(var(--gray-light)); border-radius: 6px; background: var(--surface); color: rgb(var(--gray-dark)); font: inherit; font-size: 13px; text-decoration: none; cursor: pointer; }
	.lab-actions button { border-color: var(--accent); background: var(--accent); color: white; }
	.lab-actions button:disabled { opacity: 0.5; cursor: default; }
	.save-status, .roundtrip-status { max-width: 240px; overflow: hidden; color: rgb(var(--gray)); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
	.save-status[data-state='dirty'] { color: #a15c00; }
	.save-status[data-state='error'], .roundtrip-status[data-state='changed'] { color: #b42318; }
	.save-status[data-state='saved'], .roundtrip-status[data-state='exact'] { color: #18794e; }
	.roundtrip-status { padding: 3px 7px; border-radius: 5px; background: var(--surface-soft); }
	.lab-shell { display: grid; grid-template-columns: 250px minmax(0, 1fr); width: 100%; max-width: none; height: calc(100vh - 52px); margin: 0; padding: 0; }
	.article-sidebar, .editor-panel { min-width: 0; overflow: hidden; background: var(--surface); }
	.article-sidebar { display: flex; flex-direction: column; border-right: 1px solid rgb(var(--gray-light)); }
	.panel-heading, .panel-label { display: flex; align-items: center; justify-content: space-between; min-height: 42px; padding: 0 12px; border-bottom: 1px solid rgb(var(--gray-light)); background: var(--surface-soft); }
	.panel-heading strong, .panel-heading small { display: block; }
	.panel-heading strong { font-size: 13px; }
	.panel-heading small { margin-top: 1px; color: rgb(var(--gray)); font-size: 10px; }
	#article-list { flex: 1; padding: 7px; overflow-y: auto; }
	#article-list :global(button) { display: block; width: 100%; padding: 8px 9px; border: 0; border-radius: 6px; background: transparent; color: rgb(var(--gray-dark)); text-align: left; cursor: pointer; }
	#article-list :global(button:hover), #article-list :global(button.active) { background: var(--surface-soft); }
	#article-list :global(strong), #article-list :global(span) { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	#article-list :global(strong) { font-size: 12px; }
	#article-list :global(span) { margin-top: 2px; color: rgb(var(--gray)); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; }
	.lab-notes { padding: 14px 16px; border-top: 1px solid rgb(var(--gray-light)); color: rgb(var(--gray)); font-size: 11px; line-height: 1.55; }
	.lab-notes h2 { margin: 0 0 5px; color: rgb(var(--gray-dark)); font-size: 11px; }
	.lab-notes ul { margin: 0; padding-left: 17px; }
	.lab-notes p { margin: 8px 0 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
	.editor-panel { display: flex; flex-direction: column; }
	.panel-label { min-height: 32px; color: rgb(var(--gray)); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10px; }
	.panel-label span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	#difference-detail { margin-left: 16px; }
	.crepe-host { flex: 1; min-height: 0; overflow-y: auto; background: var(--surface); }
	:global(.crepe-host .milkdown) {
		--crepe-color-background: var(--surface);
		--crepe-color-on-background: rgb(var(--gray-dark));
		--crepe-color-surface: var(--surface);
		--crepe-color-surface-low: var(--surface-soft);
		--crepe-color-on-surface: rgb(var(--gray-dark));
		--crepe-color-on-surface-variant: rgb(var(--gray));
		--crepe-color-outline: rgb(var(--gray));
		--crepe-color-primary: var(--accent);
		--crepe-color-secondary: #e7f0ff;
		--crepe-color-on-secondary: #244a7c;
		--crepe-color-hover: var(--surface-soft);
		--crepe-color-selected: #dce9fb;
		--crepe-color-inline-area: #e9edf2;
		--crepe-font-title: var(--font-atkinson), system-ui, sans-serif;
		--crepe-font-default: var(--font-atkinson), system-ui, sans-serif;
		min-height: 100%;
	}
	:global(.crepe-host .milkdown .ProseMirror) { box-sizing: border-box; width: min(100%, 840px); min-height: 100%; margin: 0 auto; padding: 64px 56px 180px; font-size: 17px; line-height: 1.72; }
	:global(.crepe-host .milkdown .ProseMirror h1) { font-size: 2.3em; font-weight: 700; letter-spacing: -0.025em; }
	:global(.crepe-host .milkdown .ProseMirror h2) { font-size: 1.65em; font-weight: 700; }
	:global(.crepe-host .milkdown .ProseMirror h3) { font-size: 1.3em; font-weight: 700; }
	:global(.crepe-host .milkdown .ProseMirror p) { line-height: 1.72; }
	:global(.crepe-host .milkdown-block-handle) { margin-left: -4px; }
	:global(.crepe-host .milkdown-slash-menu), :global(.crepe-host .milkdown-toolbar) { border: 1px solid rgb(var(--gray-light)); }
	@media (max-width: 800px) {
		.lab-shell { grid-template-columns: 190px minmax(0, 1fr); }
		.roundtrip-status, #difference-detail { display: none; }
		:global(.crepe-host .milkdown .ProseMirror) { padding-inline: 30px; }
	}
</style>
