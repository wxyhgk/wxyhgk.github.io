---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head><BaseHead title={`文章 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main class="archive">
			<header class="page-header">
				<p class="eyebrow">WRITING</p>
				<h1>文章</h1>
				<p>量子化学、电子结构与科研计算笔记。</p>
			</header>
			<section class="post-list" aria-label="文章列表">
				{posts.map((post) => (
					<article>
						<a href={`/blog/${post.id}/`}>
							<div class="post-main">
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
								<div class="tags">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
							</div>
							<p class="date"><FormattedDate date={post.data.pubDate} /></p>
							<span class="arrow" aria-hidden="true">→</span>
						</a>
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.archive { width: 880px; padding-top: 5em; }
	.page-header { padding-bottom: 2.5em; }
	.eyebrow { margin: 0 0 0.8em; color: var(--accent); font-size: 0.72em; font-weight: 700; letter-spacing: 0.16em; }
	.page-header h1 { margin-bottom: 0.25em; font-size: clamp(2.7em, 7vw, 4.8em); }
	.page-header > p:last-child { color: rgb(var(--gray)); }
	.post-list { border-top: 1px solid rgb(var(--gray-light)); }
	article { border-bottom: 1px solid rgb(var(--gray-light)); }
	article a { display: grid; grid-template-columns: 1fr auto 24px; gap: 1.5em; align-items: center; padding: 1.6em 0.4em; color: inherit; text-decoration: none; }
	article a:hover { background: var(--surface-hover); }
	article h2 { margin: 0 0 0.35em; font-size: 1.3em; }
	article p { margin: 0; }
	.post-main > p { color: rgb(var(--gray)); font-size: 0.88em; }
	.date { color: rgb(var(--gray)); font-size: 0.75em; white-space: nowrap; }
	.arrow { color: rgb(var(--gray)); transition: transform 160ms ease; }
	article a:hover .arrow { transform: translateX(4px); color: var(--accent); }
	.tags { display: flex; flex-wrap: wrap; gap: 0.35em; margin-top: 0.8em; }
	.tags span { padding: 0.14em 0.55em; border-radius: 999px; background: var(--surface-soft); color: rgb(var(--gray-dark)); font-size: 0.68em; }
	@media (max-width: 640px) {
		.archive { padding-top: 3em; }
		article a { grid-template-columns: 1fr 20px; gap: 0.75em; }
		.date { grid-column: 1; grid-row: 2; }
		.arrow { grid-column: 2; grid-row: 1 / span 2; }
	}
</style>
