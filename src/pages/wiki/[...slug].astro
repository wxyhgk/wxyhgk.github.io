---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import BlogPost from '../../layouts/BlogPost.astro';
import { articleBundlePaths } from '../../studio/server/bundle-paths.mjs';
import { DEFAULT_ARTICLE_VIEWS, readMoleculeViews } from '../../studio/server/article-views.mjs';
import { isPublishedArticle } from '../../studio/server/schemas.mjs';

export async function getStaticPaths() {
	const pages = (await getCollection('blog')).filter((entry) => isPublishedArticle(entry) && entry.data.kind === 'wiki');
	return pages.map((page) => ({
		params: { slug: page.id },
		props: page,
	}));
}
type Props = CollectionEntry<'blog'>;

const page = Astro.props;
const { Content, headings } = await render(page);
const viewsPath = articleBundlePaths(resolve('blog'), page.id).views;
const viewsSource = await readFile(viewsPath, 'utf8').catch((error) => {
	if (error?.code === 'ENOENT') return DEFAULT_ARTICLE_VIEWS;
	throw error;
});
const chemistryViews = readMoleculeViews(viewsSource);
---

<BlogPost {...page.data} headings={headings} chemistryViews={chemistryViews} articleSlug={page.id}>
	<Content />
</BlogPost>
